# ===============================
# Application Configuration
# ===============================
APP_ENV=development
APP_NAME="Sirekam Medis API"
APP_PORT=8080

# ===============================
# Database Configuration
# ===============================
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# ===============================
# JWT Configuration
# ===============================
JWT_SECRET=change-this-to-your-secret-key
JWT_EXPIRED_TIME=24h

# ===============================
# Pagination Configuration
# ===============================
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ===============================
# Redis Configuration
# ===============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=5m
REDIS_MAX_MEMORY=128mb

# ===============================
# Kafka Configuration
# ===============================
# Comma-separated list of broker addresses
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=sirekam-medis
# Set to false to disable event publishing (e.g., in testing)
KAFKA_ENABLED=true
